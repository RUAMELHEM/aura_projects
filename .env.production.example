# ==============================================================================
# AURA AI Unified Research & Audit — Production Environment Template
# ==============================================================================

# APP CONFIGURATION
APP_NAME=AURA
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://aura.example.com

# DATABASE (PostgreSQL with pgvector)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aura
DB_USERNAME=aura_user
DB_PASSWORD=change_this_secure_password_in_production

# REDIS & QUEUE
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis

# PYTHON AI SERVICE
PYTHON_SERVICE_URL=http://python:8000
PYTHON_INTERNAL_API_KEY=generate_strong_secret_key_here

# LLM API (OpenAI / Gemini for enhanced executive summaries & embeddings)
OPENAI_API_KEY=sk-proj-YOUR_API_KEY_HERE
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# FRONTEND CONFIGURATION
NEXT_PUBLIC_API_BASE_URL=https://aura.example.com/api
